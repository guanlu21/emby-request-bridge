BRIDGE_TOKEN=换成一个随机长字符串
TMDB_API_KEY=            # themoviedb.org 免费申请
PANSOU_URL=http://pansou:8888
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=        # Prowlarr → Settings → General → API Key

P115_COOKIE=             # 115 Cookie（UID=...; CID=...; SEID=...）
P115_DEST_MOVIE_CID=0    # 电影正式目录的文件夹 ID（LitePan 监控的目录）
P115_DEST_TV_CID=0       # 剧集正式目录
P115_STAGING_CID=0       # 暂存目录，必须在 LitePan 监控范围之外

EMBY_URL=http://你的NAS_IP:8096
EMBY_API_KEY=            # Emby 控制台 → API 密钥
LITEPAN_TRIGGER_URL=     # 可选；LitePan 有可用的触发接口再填
LITEPAN_WAIT_SECONDS=120

MIN_RESOLUTION=720
MIN_FILE_GB=1
MAX_FILE_GB=5
MAX_ATTEMPTS=8
OFFLINE_TIMEOUT_SECONDS=1800
